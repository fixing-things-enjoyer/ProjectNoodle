<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Sandbox provider exists only in the test APK. It never accesses user storage. -->
        <provider android:name="com.github.fixingthingsenjoyer.projectnoodle.TestDocumentsProvider"
            android:authorities="com.github.fixingthingsenjoyer.projectnoodle.test.documents"
            android:exported="true" android:grantUriPermissions="true" android:permission="android.permission.MANAGE_DOCUMENTS" />
        <provider android:name="com.github.fixingthingsenjoyer.projectnoodle.TestStorageSetupProvider"
            android:authorities="com.github.fixingthingsenjoyer.projectnoodle.test.setup" android:exported="true" />
    </application>
</manifest>
